# Pinned upstream sources for the native binaries shipped in the app.
# Bump a version together with its checksum; build.sh refuses mismatches.
# Keep this file plain KEY=VALUE: it is read by build.sh, the Dockerfile
# build args and the CI workflow.

# Android NDK (checksum is the SHA-1 Google publishes in repository2-3.xml)
NDK_VERSION=r28c
NDK_SHA1=a7b54a5de87fecd125a17d54f73c446199e72a64

# Lowest Android API level the binaries run on (matches minSdk)
ANDROID_API=23

# ABIs to build
ABIS="arm64-v8a x86_64"

ECL_VERSION=26.5.5
ECL_URL=https://common-lisp.net/project/ecl/static/files/release/ecl-26.5.5.tgz
ECL_SHA256=a01a5bcda8c5b73e59dda3494fd13e5fec5db6aa1dad782c3cc3bb57f1633435

MAXIMA_VERSION=5.50.0
MAXIMA_URL=https://downloads.sourceforge.net/sourceforge/maxima/Maxima-source/5.50.0-source/maxima-5.50.0.tar.gz
MAXIMA_SHA256=0bc4b5e11fe153ef20b24a3a816b668ece5378cc738fa24ca426b62fd6d8fc37

GNUPLOT_VERSION=6.0.5
GNUPLOT_URL=https://downloads.sourceforge.net/project/gnuplot/gnuplot/6.0.5/gnuplot-6.0.5.tar.gz
GNUPLOT_SHA256=73237f37f03306d68bfae133a9a50d5e9341384e198d5ab37eeca9ab534deed8

# QEPCAD B (quantifier elimination, used through Maxima's qepmax package)
SACLIB_VERSION=2.2.8
SACLIB_URL=https://www.usna.edu/Users/cs/wcbrown/qepcad/INSTALL/saclib2.2.8.tgz
SACLIB_SHA256=e8e3acb253c64394f35c8e17942f764cae34df731f3fe3d749b6a2ae1fb8203b

QEPCAD_VERSION=1.74
QEPCAD_URL=https://www.usna.edu/Users/cs/wcbrown/qepcad/INSTALL/qepcad-B.1.74.tgz
QEPCAD_SHA256=075db8950ef2a6d11f099b85820363f7b4d61f4aff3425cb799d7567dc1254fc

# MathJax 2 renders Maxima's TeX output in the app and the formulas in the
# manual (the app's pages use the MathJax 2 API, with SVG output).
MATHJAX_VERSION=2.7.9
MATHJAX_URL=https://github.com/mathjax/MathJax/archive/refs/tags/2.7.9.tar.gz
MATHJAX_SHA256=c9167279c87da044f2ff910ad573a02ce90354cb59440ae568eb86e1630f65df

# Languages of the Maxima manual shipped in the app (en is always built;
# upstream does not build the Russian manual)
MANUAL_LANGS="de es ja pt pt_BR"
