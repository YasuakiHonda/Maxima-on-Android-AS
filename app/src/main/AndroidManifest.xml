<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto" >

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- enableOnBackInvokedCallback: predictive back (also on Android 13-15).
         intentMatchingFlags: Android 16 "Safer Intents", intents from other apps
         must match the target's intent filter. -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:intentMatchingFlags="enforceIntentFilter"
        tools:targetApi="36"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name" >
        <activity
            android:name=".MOAInstallerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:label="@string/app_name"
            android:theme="@style/MOATheme" >
        </activity>
        <activity
            android:name=".HTMLActivity"
            android:hardwareAccelerated="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:label="@string/app_name"
            android:parentActivityName=".MaximaOnAndroidActivity"
            android:theme="@style/MOATheme" >
        </activity>
        <activity
            android:name=".ManualActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:label="@string/app_name"
            android:parentActivityName=".MaximaOnAndroidActivity"
            android:theme="@style/MOATheme" >
        </activity>
        <activity
            android:name=".MoAPreferenceActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:label="@string/app_name"
            android:parentActivityName=".MaximaOnAndroidActivity"
            android:theme="@style/MOATheme" >
        </activity>
        <activity
            android:name=".MaximaOnAndroidActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/MOATheme" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
